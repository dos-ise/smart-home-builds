{
    "name": "Gira Smart Home",
    "productName": "Gira Smart Home",
    "version": "6.0.72",
    "author": {
        "name": "Gira Giersiepen GmbH & Co. KG"
    },
    "homepage": "https://www.gira.de",
    "private": true,
    "main": "./out/main",
    "scripts": {
        "start": "rm -r out && ./scripts/run.sh --fullscreen",
        "start-debug": "rm -r out && ./scripts/run.sh --debug",
        "start-windows": "cd scripts && run.bat --debug",
        "test": "jasmine tests/*.specs.js",
        "preinstall": "node build/node/preinstall.js",
        "postinstall": "node build/node/postinstall.js",
        "compile": "gulp compile --max_old_space_size=4095",
        "watch": "gulp watch --max_old_space_size=4095",
        "gulp": "gulp --max_old_space_size=4095"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "keytar": "^7.9.0",
        "request": "^2.88.2",
        "yarn": "^1.22.21"
    },
    "devDependencies": {
        "asar": "^3.2.0",
        "debounce": "^2.0.0",
        "event-stream": "^4.0.1",
        "glob": "^10.3.10",
        "gulp": "4.0.2",
        "gulp-atom-electron": "^1.33.0",
        "gulp-bom": "^5.0.0",
        "gulp-buffer": "^0.0.2",
        "gulp-cli": "^2.3.0",
        "gulp-concat": "^2.6.1",
        "gulp-connect": "^5.7.0",
        "gulp-eslint": "^6.0.0",
        "gulp-filter": "^6.0.0",
        "gulp-json-editor": "^2.6.0",
        "gulp-rename": "^2.0.0",
        "gulp-replace": "^1.1.4",
        "gulp-shell": "^0.8.0",
        "gulp-sourcemaps": "^3.0.0",
        "gulp-uglify": "^3.0.2",
        "gulp-util": "^3.0.8",
        "gulp-watch": "^5.0.1",
        "innosetup-compiler": "^5.6.1",
        "jasmine": "^5.1.0",
        "minimatch": "^9.0.3",
        "mkdirp": "^3.0.1",
        "node-ssdp": "^4.0.1",
        "parse-semver": "^1.1.1",
        "rimraf": "^5.0.5",
        "underscore": "^1.13.6",
        "vinyl": "^3.0.0",
        "vinyl-fs": "^3.0.3",
        "yargs": "^17.7.2"
    }
